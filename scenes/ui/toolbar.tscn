[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/toolbar.gd" id="1_toolbar"]

[node name="Toolbar" type="PanelContainer"]
custom_minimum_size = Vector2(150, 0)
offset_right = 150.0
offset_bottom = 260.0
script = ExtResource("1_toolbar")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 13
text = "MATERIAL"

[node name="MaterialList" type="VBoxContainer" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 2

[node name="Separator" type="HSeparator" parent="Margin/Column"]
layout_mode = 2

[node name="StaticCheck" type="CheckBox" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Static-Flag pro Zelle: Schwerkraft wirkt nicht."
theme_override_font_sizes/font_size = 13
text = "statisch"

[node name="ResetButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Zuruecksetzen"
